# nginx 用: Basic 認証 + 検索エンジンからの除外
#
#   htpasswd -c /etc/nginx/.htpasswd teacher     # パスワードファイルを作る
#   nginx -t && systemctl reload nginx           # 反映
#
server {
    listen 443 ssl;
    server_name reader.example.com;

    root /var/www/tom-sawyer;
    index index.html;

    auth_basic           "Tom Sawyer Reader";
    auth_basic_user_file /etc/nginx/.htpasswd;

    add_header X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex" always;

    location / {
        try_files $uri $uri/ =404;
    }

    # 挿絵はキャッシュしてよい(内容は変わらないため)
    location ~* \.webp$ {
        expires 30d;
        add_header Cache-Control "private, max-age=2592000";
        add_header X-Robots-Tag "noindex, noimageindex" always;
    }
}
